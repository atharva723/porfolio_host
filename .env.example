# Copy this file to ".env" for local development and fill in your key.
# On Vercel, set these in: Project -> Settings -> Environment Variables.

# Which provider to use: groq | mistral | gemini
LLM_PROVIDER=groq

# Your API key for the chosen provider.
#   Groq (recommended, generous free tier, no card): https://console.groq.com/keys
#   Mistral:                                          https://console.mistral.ai/
#   Gemini:                                           https://aistudio.google.com/apikey
LLM_API_KEY=your_api_key_here

# Optional: override the default model.
#   groq    -> openai/gpt-oss-20b (default) or openai/gpt-oss-120b, qwen/qwen3.6-27b
#   mistral -> mistral-small-latest
#   gemini  -> gemini-1.5-flash
# NOTE: Groq periodically retires models. If the chat returns 502 "assistant is
# unavailable", check https://console.groq.com/docs/models and update this value.
# LLM_MODEL=

# Guard / verifier run on their OWN models (separate rate-limit buckets on Groq).
# GUARD_MODEL=qwen/qwen3.8-27b
# PLAN_MODEL=qwen/qwen3.8-27b
# VERIFY_MODEL=openai/gpt-oss-120b
# PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m   # "off" to disable (Groq only)
# CHAT_BUDGET_MS=25000        time budget for one chat turn

# =====================================================================
# RESPONSE CACHE (optional) — reuse answers to identical questions to
# save LLM calls. Works with no config (in-memory only). For a shared,
# durable cache across Vercel serverless instances, add a free Upstash
# Redis database (https://upstash.com) and paste its REST creds here.
# =====================================================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional cache tuning:
#   CHAT_CACHE_TTL_SECONDS  entry lifetime in seconds (default 2592000 = 30 days)
#   CHAT_CACHE_MEM_MAX      max in-memory entries (default 500)
#   CHAT_CACHE_DISABLED     set to 1 to bypass the cache entirely
# CHAT_CACHE_TTL_SECONDS=2592000
# CHAT_CACHE_MEM_MAX=500
# CHAT_CACHE_DISABLED=

# =====================================================================
# LIVE RESUME — the assistant reads your resume from a Google Doc, so
# editing the doc updates the bot with no redeploy.
#   Google Doc -> File -> Share -> Publish to web -> Document -> Publish,
#   then copy the link (https://docs.google.com/document/d/e/<id>/pub).
# Only docs.google.com published links are accepted. Phone numbers in the
# doc are redacted before the model sees it.
# =====================================================================
# RESUME_DOC_URL=
# RESUME_CACHE_SECONDS=3600     how long a fetched copy is reused (default 1 hour)

# =====================================================================
# SESSIONS & RATE LIMITS (use the same Upstash credentials as above)
# Conversation memory lives server-side; the browser only holds an opaque
# HttpOnly session cookie. Both fall back to in-memory when Redis is unset.
# =====================================================================
# SESSION_TTL_SECONDS=3600     idle lifetime of a chat session (default 1 hour)
# RATE_LIMIT_SALT=             secret salt for hashing client IPs (raw IPs are never stored)
